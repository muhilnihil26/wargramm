{
  "rules": {
    ".read": "auth != null",
    "profiles": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && (auth.uid == $uid || auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1')" }
    },
    "userActions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "lastActions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "follows": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "followers": {
      "$targetUid": {
        ".read": "auth != null",
        "$followerUid": { ".write": "auth != null && auth.uid == $followerUid" }
      }
    },
    "followRequests": {
      "$targetUid": {
        ".read": "auth != null && (auth.uid == $targetUid || data.child(auth.uid).exists())",
        "$requesterUid": { ".write": "auth != null && (auth.uid == $requesterUid || auth.uid == $targetUid)" }
      }
    },
    "bookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "postLikes": {
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$postId": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid == $uid" }
      }
    },
    "reelLikes": {
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$reelId": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid == $uid" }
      }
    },
    "postComments": {
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$postId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "reelComments": {
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$reelId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "firebasePosts": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$postId": {
        ".write": "auth != null && (!data.exists() || data.child('firebase_uid').val() == auth.uid)"
      }
    },
    "firebaseReels": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$reelId": {
        ".write": "auth != null && (!data.exists() || data.child('firebase_uid').val() == auth.uid)"
      }
    },
    "firebaseStories": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid == 'nxANfkUL63MSTv300eH6rSICw9w1'",
      "$storyId": {
        ".write": "auth != null && (!data.exists() || data.child('firebase_uid').val() == auth.uid)"
      }
    },
    "youtubeLibrary": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "messages": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "calls": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "notificationsDemo": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
